# Copy missing entries into .env. Never commit .env or paste keys into chat.
# demo = deterministic local fixtures, NO API calls; live = real paid services.
# All fields are server-only. Never use NEXT_PUBLIC_ for these values.
RUN_MODE=demo

# Choose your own unique lowercase team handle, 2–32 chars, letters/digits/dashes.
TEAM_HANDLE=

# Server-only shared token. Required for live. Generate locally; see README.
WORKER_TOKEN=
WORKER_URL=http://127.0.0.1:8000

# You.com: https://you.com/home
YDC_API_KEY=

# Parasail: https://www.saas.parasail.io/keys (inference also needs credits)
PARASAIL_API_KEY=
PARASAIL_BASE_URL=https://api.parasail.io/v1
PARASAIL_MODEL=parasail-glm-53-flash

# Intended Discord path: One, initially restricted to private tests.
# Organizer Track 1 guide currently specifies webhooks: confirm the discrepancy
# before official verification. No webhook adapter is implemented in this M0.
# One: https://app.withone.ai/settings/api-keys
# Worker maps ONE_API_KEY to ONE_SECRET only in its local MCP subprocess.
ONE_API_KEY=
# Required for dispatch: explicitly allowed connection keys, comma separated.
ONE_CONNECTION_KEYS=
# No fallback target. Official venue channel is denied even if allowlisted.
DISCORD_CHANNEL_ID=
DISCORD_ALLOWED_CHANNEL_IDS=
# Requires RUN_MODE=live and a configured private channel in the allowlist.
# Feed/tick escalation destinations are ignored; they never redirect dispatch.
# Set only after separately authorizing a real private test send.
DISCORD_SEND_ENABLED=false

# Organizer-operated service; normally requires no key.
SCENARIO_MCP=https://api.you.com/mcp/halloween-hack-26
SCENARIO_NAME=outbreak-level-5
# Only fill this if the organizers issue a team token.
SCENARIO_TEAM_TOKEN=
# RUN_MODE=live does not authorize consuming ticks or changing the scoreboard.
# Enable separately only when ready for each external side effect.
SCENARIO_ALLOW_TICK=false
SCENARIO_ALLOW_SUBMIT=false

# Optional local worker database. Leave unset to use worker/.data/runs.sqlite3.
# WORKER_DB=
# Isolated smoke scripts set SKIP_DOTENV=1 and supply a clean environment.

# Keep local agent runs out of telemetry services.
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true
DO_NOT_TRACK=true
NEXT_TELEMETRY_DISABLED=1
